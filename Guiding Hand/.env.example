# Server-side only (read by server/index.ts via dotenv) — never exposed to the browser bundle,
# since Vite only inlines variables prefixed with VITE_.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# ElevenLabs phone-number resource ID linked to your Twilio number (for outbound calls).
# Get it from the ElevenLabs dashboard → Phone Numbers.
ELEVENLABS_PHONE_NUMBER_ID=

# HydraDB — memory layer (server-side only). Get a key at app.hydradb.com (redeem credits HYDRA2026).
HYDRA_DB_API_KEY=
# Optional — tenant name; defaults to "prekick" if unset.
# HYDRA_TENANT_ID=prekick

# Optional — defaults to 8787 if unset (leave this line out entirely, don't set it to an empty string)
# PORT=8787
